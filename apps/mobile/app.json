{
  "expo": {
    "name": "Técnico Plus",
    "slug": "tecnico-plus",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.multivale.tecnicoplus",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Técnico Plus usa sua localização durante o expediente para registrar o trajeto e o local das O.S.",
          "locationAlwaysAndWhenInUsePermission": "O Técnico Plus registra o trajeto do expediente mesmo com o app fechado, até você encerrar o expediente.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Técnico Plus usa a câmera para registrar as fotos das O.S.",
          "recordAudioAndroid": false
        }
      ],
      "expo-screen-orientation",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#0572CE"
        }
      ]
    ]
  }
}
